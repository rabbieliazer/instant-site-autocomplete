{
  "manifest_version": 3,
  "name": "Live DNS Site Autocomplete",
  "version": "3.3",
  "description": "Press Ctrl+Space after a bare word to insert its real website link.",
  "permissions": [],
  "host_permissions": ["https://cloudflare-dns.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
